<figure class="science-medicine-emblem" aria-labelledby="science-medicine-title science-medicine-desc">
  <svg viewBox="0 0 420 340" role="img">
    <title id="science-medicine-title">科学技术与医学相互连接的徽标</title>
    <desc id="science-medicine-desc">锤子和试管位于上方两侧，扳手位于医疗十字下方，三者形成三角结构并共同连接医学核心。</desc>

    <defs>
      <linearGradient id="emblem-core" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#0b5964" />
        <stop offset="1" stop-color="#087f8c" />
      </linearGradient>
      <linearGradient id="emblem-liquid" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e5a83c" />
        <stop offset="1" stop-color="#d97706" />
      </linearGradient>
      <filter id="emblem-shadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="9" stdDeviation="10" flood-color="#153b43" flood-opacity="0.16" />
      </filter>
    </defs>

    <circle cx="210" cy="160" r="132" fill="none" stroke="#dce8e5" stroke-width="1.5" stroke-dasharray="3 10" />
    <circle cx="210" cy="160" r="102" fill="none" stroke="#bfd8d5" stroke-width="1.5" />
    <path d="M106 92 C140 111 158 129 180 147" fill="none" stroke="#d4dfdc" stroke-width="3" stroke-linecap="round" />
    <path d="M314 92 C281 111 261 129 240 147" fill="none" stroke="#d4dfdc" stroke-width="3" stroke-linecap="round" />
    <path d="M210 258 C210 241 210 228 210 215" fill="none" stroke="#d4dfdc" stroke-width="3" stroke-linecap="round" />

    <g class="emblem-hammer" transform="translate(93 85) rotate(-48)">
      <rect x="-10" y="3" width="20" height="110" rx="10" fill="#c37a31" />
      <rect x="-45" y="-20" width="90" height="39" rx="8" fill="#344b53" />
      <path d="M37 -14 L57 -7 L57 7 L37 14 Z" fill="#344b53" />
      <path d="M-32 -12 H27" stroke="#60757c" stroke-width="5" stroke-linecap="round" opacity="0.6" />
    </g>

    <g class="emblem-wrench">
      <rect x="154" y="257" width="116" height="22" rx="11" fill="#087f8c" />
      <path d="M260 268 C264 247 283 237 298 243 L279 259 V277 L298 293 C283 299 264 289 260 268 Z" fill="#087f8c" />
      <circle cx="169" cy="268" r="5.5" fill="#f7faf8" />
      <path d="M186 263 H246" stroke="#49a3a9" stroke-width="4" stroke-linecap="round" opacity="0.72" />
    </g>

    <g class="emblem-test-tube" transform="translate(315 70) rotate(25)">
      <path d="M-21 -35 H21" fill="none" stroke="#344b53" stroke-width="11" stroke-linecap="round" />
      <path d="M-14 -31 V70 C-14 91 14 91 14 70 V-31" fill="rgba(255,255,255,0.78)" stroke="#526b78" stroke-width="6" stroke-linejoin="round" />
      <path d="M-11 35 H11 V70 C11 85 -11 85 -11 70 Z" fill="url(#emblem-liquid)" />
      <circle cx="2" cy="51" r="4" fill="#fff4d4" />
      <circle cx="-4" cy="66" r="3" fill="#fff4d4" />
    </g>

    <g class="emblem-medical-core" filter="url(#emblem-shadow)">
      <circle cx="210" cy="160" r="65" fill="#f7faf8" stroke="#b9d4d1" stroke-width="2" />
      <circle cx="210" cy="160" r="52" fill="url(#emblem-core)" />
      <path d="M198 125 H222 V148 H245 V172 H222 V195 H198 V172 H175 V148 H198 Z" fill="#ffffff" />
    </g>

    <circle cx="75" cy="162" r="5" fill="#b84b62" />
    <circle cx="345" cy="162" r="5" fill="#087f8c" />
    <circle cx="210" cy="28" r="5" fill="#d97706" />
  </svg>
  <figcaption><strong>技术 × 科学 × 医学</strong><span>共同指向人的健康与福祉</span></figcaption>
</figure>
