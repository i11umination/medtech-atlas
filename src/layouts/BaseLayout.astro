---
import "../styles/global.css";
import BrandMark from "../components/BrandMark.astro";
import { sitePath } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "医学×先进技术图谱",
  description = "以解决人类疾苦为出发点，连接疾病、临床问题、工程技术与研究证据的中文知识图谱。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href={sitePath("/")} aria-label="医学×先进技术图谱首页">
        <BrandMark />
        <span>
          <strong>医学 × 先进技术</strong>
          <small>为真实医学问题寻找技术答案</small>
        </span>
      </a>
      <nav aria-label="主要导航">
        <a href={sitePath("/")}>首页</a>
        <a href={sitePath("/explore")}>图谱探索</a>
        <a href={sitePath("/request")}>提交需求</a>
        <a href={sitePath("/methodology")}>方法与声明</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>技术的终极目的，就是解决人类疾苦；本站尝试用证据追踪这一过程。</p>
      <p>内容采用机器辅助整理与逐条来源核验；除非另有标记，未经独立医学专家审核，不代表临床有效性结论。</p>
    </footer>
  </body>
</html>
