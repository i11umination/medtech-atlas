---
import BaseLayout from "../layouts/BaseLayout.astro";
import MiniGraph from "../components/MiniGraph";
import PreferencePanel from "../components/PreferencePanel";
import SearchExplorer from "../components/SearchExplorer";
import ScienceMedicineEmblem from "../components/ScienceMedicineEmblem.astro";
import StatusBadge from "../components/StatusBadge.astro";
import {
  evidenceById,
  evidenceItems,
  nodeById,
  nodes,
  preferenceOptions,
  relations,
} from "../lib/data";
import type { GraphNode } from "../lib/types";

const firstReleaseThemeIds = [
  "CLP-0001",
  "CLP-0002",
  "CLP-0003",
  "CLP-0004",
  "CLP-0005",
  "CLP-0006",
];
const themes = firstReleaseThemeIds
  .map((id) => nodeById.get(id))
  .filter(
    (node): node is GraphNode => node?.type === "clinical_problem",
  );
const themeCards = themes.map((theme) => {
  const relatedRelations = relations.filter(
    (relation) =>
      relation.source_id === theme.id || relation.target_id === theme.id,
  );
  const relatedTechnologyIds = relatedRelations
    .map((relation) =>
      relation.source_id === theme.id ? relation.target_id : relation.source_id,
    );
  const technologies = relatedTechnologyIds
    .map((id) => nodeById.get(id))
    .filter((node) => node?.type === "technology")
    .slice(0, 3);
  const evidence = [...new Set(relatedRelations.flatMap((relation) => relation.evidence_ids))]
    .map((id) => evidenceById.get(id))
    .filter((item): item is NonNullable<typeof item> => Boolean(item));
  return {
    theme,
    technologies,
    evidenceCount: evidence.length,
    headlineEvidence: evidence[0],
  };
});
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-copy">
      <span class="eyebrow">以人的需要，衡量技术的价值</span>
      <h1>技术的终极目的，就是解决人类疾苦。</h1>
      <p>
        我们从疾病和临床问题出发，追踪机械工程、自动化与机器人等技术正在解决什么、
        已经证明什么，以及距离真正减轻疾苦还有多远。
      </p>
      <div class="hero-stats" aria-label="首版内容规模">
        <span><strong>{nodes.length}</strong> 个节点</span>
        <span><strong>{relations.length}</strong> 条关系</span>
        <span><strong>{evidenceItems.length}</strong> 张证据卡</span>
      </div>
    </div>
    <div class="hero-note">
      <ScienceMedicineEmblem />
      <div class="hero-note-copy">
        <span class="note-index">01</span>
        <p>每一项技术都应该回到一个具体的人类问题：它能<strong>减轻什么、改善什么、还需要证明什么</strong>。</p>
      </div>
    </div>
  </section>

  <section class="search-section page-shell" aria-labelledby="search-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">从真实问题出发</span>
        <h2 id="search-title">你希望技术帮助解决什么？</h2>
      </div>
      <p>描述一种疾病、一项功能障碍，或一个尚未解决的医学问题。</p>
    </div>
    <SearchExplorer client:load nodes={nodes} />
    <PreferencePanel client:idle options={preferenceOptions} />
  </section>

  <section class="graph-section page-shell" aria-labelledby="graph-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">从问题到证据</span>
        <h2 id="graph-title">把技术放回它要解决的医学问题中</h2>
      </div>
      <a class="text-link" href="/explore">打开完整图谱 →</a>
    </div>
    <MiniGraph client:visible nodes={nodes} relations={relations} />
  </section>

  <section class="themes-section page-shell" aria-labelledby="themes-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">需要被解决的问题</span>
        <h2 id="themes-title">六类医学难题，六条技术探索路径</h2>
      </div>
      <p>每条路径都追问技术能否真正改善人的功能、生活与健康结局。</p>
    </div>
    <div class="theme-grid">
      {themeCards.map(({ theme, technologies, evidenceCount, headlineEvidence }, index) => (
        <a class="theme-card" href={`/entity/${theme.id}`}>
          <div class="theme-card-top">
            <span class="theme-number">0{index + 1}</span>
            <StatusBadge status={theme.status} />
          </div>
          <h3>{theme.name}</h3>
          <p>
            {technologies.length
              ? `关联方向：${technologies.map((item) => item?.name).join("、")}`
              : "关联技术路径正在建立"}
          </p>
          <div class="theme-card-evidence-meta">
            <span>{headlineEvidence?.research_stage ?? "证据待补充"}</span>
            <span>{evidenceCount ? `${evidenceCount} 张证据卡` : "暂无证据卡"}</span>
            <span>{headlineEvidence ? `代表研究 n=${headlineEvidence.sample_size ?? "未报告"}` : "样本量未报告"}</span>
          </div>
          {headlineEvidence && (
            <div class="theme-card-evidence">
              <small>代表性研究发现</small>
              <p>{headlineEvidence.findings}</p>
            </div>
          )}
          <span class="card-action">
            {evidenceCount ? `查看 ${evidenceCount} 张证据卡与关联关系 →` : "查看关系与证据 →"}
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="principles-section page-shell" aria-labelledby="principles-title">
    <div class="section-heading inverse-heading">
      <div>
        <span class="eyebrow">用人的结局校准技术</span>
        <h2 id="principles-title">真正有价值的技术，要经得起证据检验</h2>
      </div>
    </div>
    <div class="principle-grid">
      <article><span>01</span><h3>先问解决了什么</h3><p>一项技术必须对应具体疾病负担、功能困难或医疗流程中的真实问题。</p></article>
      <article><span>02</span><h3>再问证据走到哪里</h3><p>获批使用、临床试验、早期人体研究与实验室发现必须清楚分开。</p></article>
      <article><span>03</span><h3>最后问怎样继续验证</h3><p>未来方向将说明研究依据、验证路径，以及距离改善患者结局还有哪些障碍。</p></article>
    </div>
    <a class="button button-light" href="/methodology">了解我们如何判断技术是否真正有用</a>
  </section>
</BaseLayout>
