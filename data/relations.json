    { "id": "REL-0038", "source_id": "RES-0008", "target_id": "CLP-0004", "relation_type": "studies", "label": "研究非侵入感觉反馈的日常使用", "mechanism_summary": "观察非侵入机械触觉反馈使用前后的体验和功能。", "research_stage": "早期人体研究", "evidence_ids": ["EVD-0008"], "limitations": "样本小、无平行对照，定性与定量结果冲突。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0039", "source_id": "RES-0009", "target_id": "CLP-0005", "relation_type": "studies", "label": "报告治疗性神经血管介入可行性", "mechanism_summary": "描述机器人辅助完成基底动脉瘤支架辅助栓塞。", "research_stage": "早期人体研究", "evidence_ids": ["EVD-0009"], "limitations": "单例且无对照，只支持可行性。", "status": "needs-review", "last_verified": "2026-09-12" },
