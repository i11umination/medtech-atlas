    { "id": "REL-0041", "source_id": "RES-0011", "target_id": "CLP-0006", "relation_type": "studies", "label": "汇总机器人脊柱手术随机证据", "mechanism_summary": "比较机器人和传统方法的精度、围术期与临床结局。", "research_stage": "临床试验", "evidence_ids": ["EVD-0011"], "limitations": "系统和适应证异质，临床疗效优势未明确。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0042", "source_id": "RES-0012", "target_id": "CLP-0006", "relation_type": "studies", "label": "汇总退行性腰椎机器人融合术证据", "mechanism_summary": "比较机器人辅助与透视辅助 MIS-TLIF。", "research_stage": "临床试验", "evidence_ids": ["EVD-0012"], "limitations": "术中指标差异未转化为明确症状和功能优势。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0043", "source_id": "RES-0013", "target_id": "TEC-0007", "relation_type": "studies", "label": "验证自动化类器官筛选流程", "mechanism_summary": "用 384 孔流程评估自动培养和筛选的稳健性。", "research_stage": "体外研究", "evidence_ids": ["EVD-0013"], "limitations": "体外稳健性不能证明临床预测价值。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0044", "source_id": "RES-0014", "target_id": "TEC-0007", "relation_type": "studies", "label": "验证自动化类器官图像分析", "mechanism_summary": "比较无标记图像分析与参考体外分析方法。", "research_stage": "体外研究", "evidence_ids": ["EVD-0014"], "limitations": "工具验证不能证明临床决策或患者获益。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0045", "source_id": "RES-0015", "target_id": "CLP-0001", "relation_type": "studies", "label": "汇总上肢机器人训练功能结局", "mechanism_summary": "汇总上肢机器人训练与常规康复在运动和日常活动量表上的差异。", "research_stage": "临床试验", "evidence_ids": ["EVD-0015"], "limitations": "量表差异和临床重要性并不等价，设备与方案异质性限制外推。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0046", "source_id": "RES-0016", "target_id": "CLP-0001", "relation_type": "studies", "label": "研究卒中阶段与严重程度的差异", "mechanism_summary": "在不同卒中阶段和严重程度人群中比较机器人辅助治疗与常规作业治疗。", "research_stage": "临床试验", "evidence_ids": ["EVD-0016"], "limitations": "主要结局未显示整体优势，亚组信号仍需预注册和更大样本验证。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0047", "source_id": "RES-0017", "target_id": "CLP-0005", "relation_type": "studies", "label": "评估脑动脉瘤机器人栓塞可行性", "mechanism_summary": "在多中心前瞻性研究中评估机器人完成脑动脉瘤血管内栓塞的技术终点与安全事件。", "research_stage": "早期人体研究", "evidence_ids": ["EVD-0017"], "limitations": "单臂设计、没有平行手工对照，技术完成率不能证明长期患者获益。", "status": "needs-review", "last_verified": "2026-09-12" },
    { "id": "REL-0048", "source_id": "RES-0018", "target_id": "CLP-0005", "relation_type": "studies", "label": "比较神经血管介入流程与术者负担", "mechanism_summary": "比较机器人与手工介入的流程时间、技术成功、转换和术者辐射暴露。", "research_stage": "早期人体研究", "evidence_ids": ["EVD-0018"], "limitations": "单中心回顾性系列，病例以诊断性造影为主，不能替代脑动脉瘤治疗的比较研究。", "status": "needs-review", "last_verified": "2026-09-12" }
